# burners.env — THROWAWAY platform logins ONLY for the reach container.
# Lives at /opt/reach/secrets/burners.env (chmod 600). Copy to burners.env, fill, never commit.
#
# HARD RULES:
#   - These are DISPOSABLE accounts. Never your personal or commercial logins.
#   - This file must contain NOTHING of value — no OpenRouter/Neon/Composio key, no real password
#     you reuse anywhere. If reach is compromised, the total loss must be "some burner accounts."
#   - If a burner gets suspended (expected, per agent-reach's own warning), just make another.

# --- Reddit burner ---
REDDIT_BURNER_USER=
REDDIT_BURNER_PASS=

# --- Instagram burner ---
IG_BURNER_USER=
IG_BURNER_PASS=

# --- Facebook burner ---
FB_BURNER_USER=
FB_BURNER_PASS=

# agent-reach captures session cookies from these logins on first run and caches them in
# /app/state (the reach-only volume). Cookies never leave the reach container.
