# hermes.env — REAL secrets for the hermes container. Lives at /opt/hermes/secrets/hermes.env (chmod 600).
# Copy to hermes.env, fill in, never commit the filled version. reach NEVER sees this file.

# --- OpenRouter (one account, per-profile capped keys) ---
OPENROUTER_API_KEY_DIRECTOR=sk-or-...          # capped key, director profile
OPENROUTER_API_KEY_SCOUT=sk-or-...             # capped key, scout profile
OPENROUTER_API_KEY_ANALYST=sk-or-...           # capped key, analyst profile
OPENROUTER_PLANNER_MODEL=tencent/hy3-20260706  # v3 query planner — pin exact slug, never an alias
PLANNER_ENABLED=0                              # off until bakeoff + one verified live run
MAX_REVISION_ROUNDS=0                          # v3 revision loop — set 1 after one verified live run
FOLLOWUP_ENABLED=0                             # v3 gap-driven iteration — enable after one verified live run
FOLLOWUP_ROUNDS=1                              # supports N; convergence-gated by FOLLOWUP_MIN_CLOSURE
FOLLOWUP_MAX_SUBQS=3
FOLLOWUP_BUDGET_FRACTION=0.5                   # each round's slice of the run ceilings, compounds per round
FOLLOWUP_MIN_CLOSURE=0.3                       # a round must close 30% of unknowns to earn another
DECOMPOSE_ENABLED=1                            # facet-test decomposition; on by default, fail-soft to 1 sub-question
DECOMPOSE_MAX_SUBQS=5
X_SEARCH_ARCHIVE=0                             # flip after the /search/all tier probe succeeds
FORUM_REACH_CAP=4                              # forum-shaped web hits routed to the browser reader per subq
PRIORS_MIN_N=5                                 # observations before the vertical memory speaks
PRIORS_SURPRISE_FACTOR=3                       # deviation from median that earns a flag finding
OPENROUTER_BULK_MODEL=nvidia/nemotron-...:free # free model for bulk extraction (pin exact slug in Phase 3)
OPENROUTER_SYNTH_MODEL=moonshotai/kimi-...     # cheap Kimi-tier for synthesis (pin exact slug in Phase 3)
OPENROUTER_DAILY_CAP_USD=2                      # hard stop; engine refuses calls past this

# --- Neon Postgres (project hermes-research) ---
DATABASE_URL=postgresql://...neon.tech/hermes-research?sslmode=require

# --- Composio (Hermes-owned account, GitHub connector) ---
COMPOSIO_API_KEY=comp_...

# --- X / Twitter (official API, pay-per-use) ---
X_BEARER_TOKEN=...

# --- Telegram gateway (owner control surface) ---
TELEGRAM_BOT_TOKEN=...
TELEGRAM_OWNER_ID=...                           # your numeric chat id — the ONLY allowlisted user

# --- Jina Reader (web reading; free tier, optional key for higher limits) ---
JINA_API_KEY=
